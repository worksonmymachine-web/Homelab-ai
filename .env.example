# Homelab AI runtime configuration
# Copy to .env with: ./scripts/setup.sh

COMPOSE_PROJECT_NAME=homelab-ai

# Host ports are localhost-only by default.
LITELLM_PORT=4000
SEARXNG_PORT=8888

# Smoke-test model: official Qwen GGUF, ~1.12 GB.
MODEL_FILE=qwen2.5-1.5b-instruct-q4_k_m.gguf
MODEL_URL=https://huggingface.co/Qwen/Qwen2.5-1.5B-Instruct-GGUF/resolve/main/qwen2.5-1.5b-instruct-q4_k_m.gguf?download=true
MODEL_APPROX_BYTES=1200000000
LITELLM_MODEL_NAME=local-qwen

# llama-server tuning. Keep conservative for the first smoke test.
LLAMA_CTX_SIZE=4096
# LLAMA_GPU_LAYERS=all is tuned for the CUDA/NVIDIA baseline. Re-check this
# value (and LLAMA_CTX_SIZE) for Vulkan/ROCm once real layer count and memory
# behavior are known on the Strix Halo hardware — do not assume it carries over.
LLAMA_GPU_LAYERS=all
LLAMA_THREADS=8

# Images pinned to explicit release tags. Export records immutable digests.
LLAMA_CPU_IMAGE=ghcr.io/ggml-org/llama.cpp:server-b10524
LLAMA_NVIDIA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda13-b10524
LLAMA_AMD_IMAGE=ghcr.io/ggml-org/llama.cpp:server-vulkan-b10524
LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.94.0
SEARXNG_IMAGE=ghcr.io/searxng/searxng:2026.8.20-8d3dd0cd4
SANDBOX_IMAGE=homelab-ai-sandbox:0.1.0

# Generated by scripts/setup.sh. Do not commit the real .env.
SEARXNG_SECRET=REPLACE_ME

# Sandbox resource limits.
SANDBOX_UID=1000
SANDBOX_GID=1000
SANDBOX_CPUS=2.0
SANDBOX_MEMORY=2g
SANDBOX_PIDS=256

# Where the GGUF weights live. The default keeps the previous behaviour
# (./models inside the project). Point it elsewhere once the weights are tens
# of GB and no longer belong inside a git working tree, e.g. on Windows/WSL2:
#   MODELS_DIR=/mnt/c/Users/<user>/models
MODELS_DIR=./models

# Future AMD safety gate. Keep 0 until docs/amd-migration.md has been followed.
ALLOW_UNVALIDATED_AMD=0

# Which runtime preflight.sh probes on the amd branch: vulkan or rocm.
# compose.amd.yml pins the Vulkan image, so vulkan is the matching default.
AMD_RUNTIME=vulkan
# Strix Halo / Ryzen AI Max+ 395. Only used to warn on a mismatch under rocm.
AMD_EXPECTED_GFX=gfx1151


# Portable PostgreSQL core. Real password is generated into .env and is not committed.
POSTGRES_IMAGE=postgres:18.6-bookworm
POSTGRES_USER=homelab_ai
POSTGRES_DB=homelab_ai
POSTGRES_PASSWORD=REPLACE_ME


# Portable vector/search database.
QDRANT_IMAGE=qdrant/qdrant:v1.18.1
